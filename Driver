  async function salvaSuSupabase(dati) {
    try {
      await fetch(SB_URL + '/rest/v1/corse', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'apikey': SB_KEY,
          'Authorization': 'Bearer ' + SB_KEY,
          'Prefer': 'return=representation'
