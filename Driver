      console.warn('Errore salvataggio Supabase:', e);
    }
  }

  // ---- CITTÀ VENETO con coordinate approssimative ----
  const CITTA_COORD = {
    'venezia': { lat: 45.4408, lng: 12.3155 },
    'mestre': { lat: 45.4929, lng: 12.2381 },
    'mira': { lat: 45.4333, lng: 12.1333 },
    'padova': { lat: 45.4064, lng: 11.8768 },
    'treviso': { lat: 45.6669, lng: 12.2430 },
    'vicenza': { lat: 45.5455, lng: 11.5354 },
    'verona': { lat: 45.4384, lng: 10.9916 },
    'trieste': { lat: 45.6495, lng: 13.7768 },
    'udine': { lat: 46.0633, lng: 13.2355 },
    'pordenone': { lat: 45.9564, lng: 12.6614 },
    'belluno': { lat: 46.1406, lng: 12.2167 },
    'rovigo': { lat: 45.0707, lng: 11.7900 },
    'ferrara': { lat: 44.8381, lng: 11.6195 },
    'bologna': { lat: 44.4949, lng: 11.3426 },
    'trento': { lat: 46.0679, lng: 11.1211 },
    'bolzano': { lat: 46.4983, lng: 11.3548 },
    'brescia': { lat: 45.5416, lng: 10.2118 },
    'bergamo': { lat: 45.6983, lng: 9.6773 },
    'milano': { lat: 45.4654, lng: 9.1859 },
    'mantova': { lat: 45.1564, lng: 10.7914 },
    'cremona': { lat: 45.1327, lng: 10.0227 },
    'gorizia': { lat: 45.9407, lng: 13.6219 },
  };

  const VENEZIA = { lat: 45.4408, lng: 12.3155 };
  const RAGGIO_KM = 150;

  function distanzaKm(lat1, lng1, lat2, lng2) {
    const R = 6371;
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLng = (lng2 - lng1) * Math.PI / 180;
    const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
              Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
              Math.sin(dLng/2) * Math.sin(dLng/2);
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
  }

  function verificaRaggio() {
    const val = document.getElementById('s-partenza').value.trim().toLowerCase();
    const box = document.getElementById('radius-check');
    if (val.length < 3) { box.style.display = 'none'; return; }
    let trovata = null;
    for (const [citta, coord] of Object.entries(CITTA_COORD)) {
      if (val.includes(citta) || citta.includes(val)) { trovata = { citta, coord }; break; }
    }
    if (!trovata) { box.style.display = 'none'; return; }
    const dist = Math.round(distanzaKm(VENEZIA.lat, VENEZIA.lng, trovata.coord.lat, trovata.coord.lng));
    box.style.display = 'block';
    if (dist <= RAGGIO_KM) {
      box.className = 'radius-check ok sans';
      box.innerHTML = '✓ ' + trovata.citta.charAt(0).toUpperCase() + trovata.citta.slice(1) + ' è nella nostra zona di servizio (' + dist + ' km da Venezia)';
    } else {
      box.className = 'radius-check ko sans';
      box.innerHTML = '✕ ' + trovata.citta.charAt(0).toUpperCase() + trovata.citta.slice(1) + ' è fuori dal nostro raggio di servizio (' + dist + ' km — max ' + RAGGIO_KM + ' km)';
    }
  }

  // ---- PREZZI ----
  let prezzoBase = 0;
  function aggiornaPrezzoBase() {
    const sel = document.getElementById('s-servizio');
    const opt = sel.options[sel.selectedIndex];
    prezzoBase = parseInt(opt.dataset.prezzo) || 0;
  }

  function calcolaPrezzo() {
    const pass = document.getElementById('s-passeggeri').value;
    let extra = 0;
    if (pass === '5-8') extra += 50;
    return prezzoBase + extra;
  }

  // ---- STEP NAVIGATION ----
  let stepCorrente = 1;

  function aggiornaSteps(step) {
    for (let i = 1; i <= 3; i++) {
      const num = document.getElementById('snum-' + i);
      const lbl = document.getElementById('slbl-' + i);
      if (i < step) { num.className = 'step-num done'; num.textContent = '✓'; lbl.className = 'step-lbl'; }
      else if (i === step) { num.className = 'step-num active'; num.textContent = i; lbl.className = 'step-lbl active'; }
      else { num.className = 'step-num'; num.textContent = i; lbl.className = 'step-lbl'; }
    }
    document.querySelectorAll('.form-section').forEach(s => s.classList.remove('active'));
    document.getElementById('step' + step).classList.add('active');
    stepCorrente = step;
    document.getElementById('prenota').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function vaiStep(n) { aggiornaSteps(n); }

  function vaiStep2() {
    const servizio = document.getElementById('s-servizio').value;
    const data     = document.getElementById('s-data').value;
    const ora      = document.getElementById('s-ora').value;
    const partenza = document.getElementById('s-partenza').value.trim();
    const dest     = document.getElementById('s-destinazione').value.trim();
    if (!servizio) { showToast('Seleziona un tipo di servizio', 'err'); return; }
    if (!data)     { showToast('Inserisci la data', 'err'); return; }
    if (!ora)      { showToast('Inserisci l\'ora di partenza', 'err'); return; }
    if (!partenza) { showToast('Inserisci il luogo di partenza', 'err'); return; }
    if (!dest)     { showToast('Inserisci la destinazione', 'err'); return; }

    // Verifica raggio
    const val = partenza.toLowerCase();
    let fora = false;
    for (const [citta, coord] of Object.entries(CITTA_COORD)) {
      if (val.includes(citta) || citta.includes(val)) {
        const dist = Math.round(distanzaKm(VENEZIA.lat, VENEZIA.lng, coord.lat, coord.lng));
        if (dist > RAGGIO_KM) { fora = true; }
        break;
      }
    }
    if (fora) { showToast('Questa destinazione è fuori dal nostro raggio di servizio (150 km)', 'err'); return; }

    aggiornaSteps(2);
  }

  function vaiStep3() {
    const nome    = document.getElementById('s-nome').value.trim();
    const cognome = document.getElementById('s-cognome').value.trim();
    const email   = document.getElementById('s-email').value.trim();
    const tel     = document.getElementById('s-telefono').value.trim();
    if (!nome || !cognome) { showToast('Inserisci nome e cognome', 'err'); return; }
    if (!email || !email.includes('@')) { showToast('Inserisci una email valida', 'err'); return; }
    if (!tel) { showToast('Inserisci il numero di telefono', 'err'); return; }

    // Popola riepilogo
    const serviziNomi = { aeroporto:'Trasferimento Aeroporto', business:'Transfer Business', serale:'Servizio Serale & Eventi', tour:'City Tour Privato' };
    const prezzo = calcolaPrezzo();
    document.getElementById('prev-servizio').textContent   = serviziNomi[document.getElementById('s-servizio').value] || '—';
    document.getElementById('prev-data').textContent       = document.getElementById('s-data').value + ' alle ' + document.getElementById('s-ora').value;
    document.getElementById('prev-partenza').textContent   = document.getElementById('s-partenza').value;
    document.getElementById('prev-destinazione').textContent = document.getElementById('s-destinazione').value;
    document.getElementById('prev-passeggeri').textContent = document.getElementById('s-passeggeri').value + ' passeggero/i';
    document.getElementById('prev-nome').textContent       = nome + ' ' + cognome;
    document.getElementById('prev-totale').textContent     = prezzo + ' €';

    aggiornaSteps(3);
  }

  // ---- FORMATTAZIONE CARTA ----
  function formatCard(input) {
    let v = input.value.replace(/\D/g, '').substring(0, 16);
    input.value = v.match(/.{1,4}/g)?.join(' ') || v;
  }
  function formatExpiry(input) {
    let v = input.value.replace(/\D/g, '').substring(0, 4);
    if (v.length >= 2) v = v.substring(0,2) + '/' + v.substring(2);
    input.value = v;
  }

  // ---- CONFERMA PRENOTAZIONE ----
  async function confermaPrenotazione() {
    const carta = document.getElementById('pay-carta').value.replace(/\s/g, '');
    const scad  = document.getElementById('pay-scad').value;
    const cvv   = document.getElementById('pay-cvv').value;
    if (carta.length < 16) { showToast('Inserisci un numero di carta valido', 'err'); return; }
    if (scad.length < 5)   { showToast('Inserisci la data di scadenza', 'err'); return; }
    if (cvv.length < 3)    { showToast('Inserisci il CVV', 'err'); return; }

    const btn = document.getElementById('btn-conferma');
    btn.textContent = 'Elaborazione...';
    btn.classList.add('btn-loading');

    // Simula elaborazione pagamento
    await new Promise(r => setTimeout(r, 1800));

    const nome    = document.getElementById('s-nome').value.trim();
    const cognome = document.getElementById('s-cognome').value.trim();
    const email   = document.getElementById('s-email').value.trim();
    const prezzo  = calcolaPrezzo();
    const serviziNomi = { aeroporto:'Trasferimento Aeroporto', business:'Transfer Business', serale:'Servizio Serale & Eventi', tour:'City Tour Privato' };
    const codice = 'VED-' + Date.now().toString().slice(-6);

    // Salva su Supabase
    await salvaSuSupabase({
      commerciante_id: CID,
      cliente:      nome + ' ' + cognome,
      telefono:     document.getElementById('s-telefono').value.trim(),
      email,
      partenza:     document.getElementById('s-partenza').value.trim(),
      destinazione: document.getElementById('s-destinazione').value.trim(),
      servizio:     serviziNomi[document.getElementById('s-servizio').value] || '—',
      data:         document.getElementById('s-data').value,
      ora:          document.getElementById('s-ora').value,
      passeggeri:   document.getElementById('s-passeggeri').value,
      importo:      prezzo,
      note:         (document.getElementById('s-note').value.trim() || '') + (document.getElementById('s-volo').value ? ' | Volo: ' + document.getElementById('s-volo').value : ''),
      volo:         document.getElementById('s-volo').value.trim(),
      stato:        'prenotata',
      da_online:    true
    });

    // Invia email con EmailJS
    try {
      await emailjs.send('service_711aee7', 'template_ir4q82f', {
        nome_cliente: nome + ' ' + cognome,
        data:         document.getElementById('s-data').value,
        ora:          document.getElementById('s-ora').value,
        partenza:     document.getElementById('s-partenza').value,
        destinazione: document.getElementById('s-destinazione').value,
        servizio:     serviziNomi[document.getElementById('s-servizio').value] || '—',
        importo:      prezzo,
        codice,
        to_email:     email,
      });
    } catch(e) {
      console.warn('Email non inviata:', e);
    }

    // Mostra success
    document.getElementById('booking-form').style.display = 'none';
    document.getElementById('booking-success').classList.add('show');
    document.getElementById('success-code').textContent = codice;
    document.getElementById('prenota').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function nuovaPrenotazione() {
    document.getElementById('booking-form').style.display = 'block';
    document.getElementById('booking-success').classList.remove('show');
    document.querySelectorAll('input, select').forEach(el => { if (el.type !== 'submit') el.value = ''; });
    document.getElementById('radius-check').style.display = 'none';
    document.getElementById('btn-conferma').textContent = 'Conferma e paga →';
    document.getElementById('btn-conferma').classList.remove('btn-loading');
    aggiornaSteps(1);
  }

  // ---- TOAST ----
  let toastTimer;
  function showToast(msg, tipo) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.className = tipo === 'err' ? 'show err sans' : 'show sans';
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => { t.className = ''; }, 3000);
  }

  // ---- INIT ----
  document.addEventListener('DOMContentLoaded', () => {
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('s-data').min = today;
    document.getElementById('s-data').value = today;
  });
</script>
