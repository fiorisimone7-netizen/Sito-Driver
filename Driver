<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="Venice Executive Driver — Servizio di trasporto privato di lusso a Venezia. Prenotazione online, puntualità e discrezione garantite.">
<title>Venice Executive Driver</title>
<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
<style>
  :root {
    --black: #0A0A0A;
    --dark: #111111;
    --dark2: #1A1A1A;
    --dark3: #222222;
    --gold: #C9A84C;
    --gold-light: #E8D5A3;
    --gold-dark: #9A7A2E;
    --gold-pale: #1A1500;
    --text: #F5F5F0;
    --text2: #A0A090;
    --text3: #6A6A60;
    --border: #2A2A28;
    --border2: #333330;
    --success: #4CAF7D;
    --danger: #E05555;
    --radius: 12px;
    --shadow: 0 4px 30px rgba(0,0,0,0.5);
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body { font-family: 'Georgia', 'Times New Roman', serif; background: var(--black); color: var(--text); line-height: 1.7; }

  /* ---- FONTS ---- */
  .sans { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }

  /* ---- HEADER ---- */
  header { position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: rgba(10,10,10,0.95); backdrop-filter: blur(20px); border-bottom: 1px solid var(--border); }
  .header-inner { max-width: 1100px; margin: 0 auto; padding: 16px 32px; display: flex; align-items: center; justify-content: space-between; }
  .logo { display: flex; flex-direction: column; }
  .logo-main { font-size: 18px; font-weight: 400; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold); }
  .logo-sub { font-size: 9px; color: var(--text3); letter-spacing: 0.3em; text-transform: uppercase; margin-top: 2px; }
  .nav-links { display: flex; gap: 32px; }
  .nav-links a { font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 11px; color: var(--text3); text-decoration: none; letter-spacing: 0.12em; text-transform: uppercase; transition: color 0.2s; }
  .nav-links a:hover { color: var(--gold); }
  .btn-prenota-nav { font-family: -apple-system, BlinkMacSystemFont, sans-serif; padding: 10px 24px; background: transparent; border: 1px solid var(--gold); color: var(--gold); border-radius: 2px; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; cursor: pointer; text-decoration: none; display: inline-block; transition: all 0.2s; }
  .btn-prenota-nav:hover { background: var(--gold); color: var(--black); }

  /* ---- HERO ---- */
  .hero { min-height: 100vh; display: flex; align-items: center; justify-content: center; text-align: center; padding: 120px 32px 80px; position: relative; overflow: hidden; }
  .hero::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at center, rgba(201,168,76,0.06) 0%, transparent 70%); }
  .hero-eyebrow { font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 10px; color: var(--gold); letter-spacing: 0.3em; text-transform: uppercase; margin-bottom: 24px; }
  .hero h1 { font-size: clamp(36px, 6vw, 72px); font-weight: 400; letter-spacing: 0.06em; line-height: 1.15; margin-bottom: 24px; color: var(--text); }
  .hero h1 em { font-style: italic; color: var(--gold); }
  .hero-line { width: 60px; height: 1px; background: var(--gold); margin: 28px auto; opacity: 0.5; }
  .hero p { font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 15px; color: var(--text2); max-width: 520px; margin: 0 auto 40px; line-height: 1.8; letter-spacing: 0.02em; }
  .hero-cta { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
  .btn-primary { font-family: -apple-system, BlinkMacSystemFont, sans-serif; padding: 16px 40px; background: var(--gold); color: var(--black); border: none; font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; cursor: pointer; text-decoration: none; display: inline-block; transition: all 0.2s; }
  .btn-primary:hover { background: var(--gold-light); }
  .btn-outline { font-family: -apple-system, BlinkMacSystemFont, sans-serif; padding: 16px 40px; background: transparent; color: var(--text2); border: 1px solid var(--border2); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; cursor: pointer; text-decoration: none; display: inline-block; transition: all 0.2s; }
  .btn-outline:hover { border-color: var(--gold); color: var(--gold); }
  .hero-scroll { position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%); font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 10px; color: var(--text3); letter-spacing: 0.2em; text-transform: uppercase; display: flex; flex-direction: column; align-items: center; gap: 8px; }
  .scroll-line { width: 1px; height: 40px; background: linear-gradient(to bottom, var(--gold), transparent); }

  /* ---- SEZIONI ---- */
  section { padding: 100px 32px; }
  .section-inner { max-width: 1100px; margin: 0 auto; }
  .section-eyebrow { font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 10px; color: var(--gold); letter-spacing: 0.3em; text-transform: uppercase; margin-bottom: 16px; text-align: center; }
  .section-title { font-size: clamp(28px, 4vw, 48px); font-weight: 400; text-align: center; margin-bottom: 16px; letter-spacing: 0.04em; }
  .section-line { width: 40px; height: 1px; background: var(--gold); margin: 24px auto 48px; opacity: 0.5; }
  .section-sub { font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 14px; color: var(--text2); text-align: center; max-width: 560px; margin: 0 auto 56px; line-height: 1.8; }

  /* ---- SERVIZI ---- */
  #servizi { background: var(--dark); }
  .servizi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1px; background: var(--border); border: 1px solid var(--border); }
  .servizio-card { background: var(--dark2); padding: 40px 32px; transition: background 0.2s; }
  .servizio-card:hover { background: var(--dark3); }
  .serv-icon { font-size: 28px; margin-bottom: 20px; }
  .serv-nome { font-size: 16px; letter-spacing: 0.08em; color: var(--text); margin-bottom: 10px; }
  .serv-desc { font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 13px; color: var(--text3); line-height: 1.7; margin-bottom: 16px; }
  .serv-prezzo { font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 12px; color: var(--gold); letter-spacing: 0.08em; }

  /* ---- NUMERI ---- */
  #numeri { background: var(--black); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 60px 32px; }
  .numeri-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; max-width: 900px; margin: 0 auto; }
  .numero-item { text-align: center; padding: 24px; border-right: 1px solid var(--border); }
  .numero-item:last-child { border-right: none; }
  .numero-val { font-size: 42px; color: var(--gold); margin-bottom: 6px; }
  .numero-lbl { font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 10px; color: var(--text3); letter-spacing: 0.14em; text-transform: uppercase; }

  /* ---- BOOKING ---- */
  #prenota { background: var(--dark); }
  .booking-wrap { max-width: 720px; margin: 0 auto; }
  .booking-steps { display: flex; gap: 0; margin-bottom: 40px; }
  .step { flex: 1; display: flex; align-items: center; gap: 10px; }
  .step-num { width: 28px; height: 28px; border-radius: 50%; border: 1px solid var(--border2); display: flex; align-items: center; justify-content: center; font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 11px; color: var(--text3); flex-shrink: 0; transition: all 0.2s; }
  .step-num.active { border-color: var(--gold); color: var(--gold); background: var(--gold-pale); }
  .step-num.done { border-color: var(--success); background: rgba(76,175,125,0.1); color: var(--success); }
  .step-lbl { font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 11px; color: var(--text3); letter-spacing: 0.08em; text-transform: uppercase; }
  .step-lbl.active { color: var(--gold); }
  .step-line { flex: 1; height: 1px; background: var(--border); margin: 0 10px; }

  .booking-form { background: var(--dark2); border: 1px solid var(--border); padding: 40px; }
  .form-section { display: none; }
  .form-section.active { display: block; }
  .form-title { font-size: 20px; letter-spacing: 0.06em; color: var(--text); margin-bottom: 6px; }
  .form-sub { font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 13px; color: var(--text3); margin-bottom: 28px; }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .form-group { display: flex; flex-direction: column; gap: 8px; }
  .form-group.full { grid-column: 1/-1; }
  .form-label { font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 10px; color: var(--text3); letter-spacing: 0.12em; text-transform: uppercase; }
  .form-input { padding: 14px 16px; border: 1px solid var(--border2); background: var(--dark3); color: var(--text); font-size: 14px; font-family: -apple-system, BlinkMacSystemFont, sans-serif; outline: none; transition: border-color 0.2s; border-radius: 0; }
  .form-input:focus { border-color: var(--gold); }
  .form-select { padding: 14px 16px; border: 1px solid var(--border2); background: var(--dark3); color: var(--text); font-size: 14px; font-family: -apple-system, BlinkMacSystemFont, sans-serif; outline: none; appearance: none; transition: border-color 0.2s; width: 100%; }
  .form-select:focus { border-color: var(--gold); }
  .form-note { font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 11px; color: var(--text3); margin-top: 4px; }
  .form-error { font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 12px; color: var(--danger); margin-top: 4px; display: none; }
  .form-actions { display: flex; gap: 12px; margin-top: 28px; justify-content: flex-end; }
  .btn-next { font-family: -apple-system, BlinkMacSystemFont, sans-serif; padding: 14px 32px; background: var(--gold); color: var(--black); border: none; font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; cursor: pointer; transition: all 0.2s; }
  .btn-next:hover { background: var(--gold-light); }
  .btn-back { font-family: -apple-system, BlinkMacSystemFont, sans-serif; padding: 14px 24px; background: transparent; color: var(--text3); border: 1px solid var(--border2); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; cursor: pointer; transition: all 0.2s; }
  .btn-back:hover { border-color: var(--text3); color: var(--text); }

  /* RAGGIO */
  .radius-check { margin-top: 12px; padding: 12px 16px; border-radius: 0; font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 13px; display: none; }
  .radius-check.ok { background: rgba(76,175,125,0.1); border: 1px solid rgba(76,175,125,0.3); color: var(--success); }
  .radius-check.ko { background: rgba(224,85,85,0.1); border: 1px solid rgba(224,85,85,0.3); color: var(--danger); }

  /* PREVENTIVO */
  .preventivo-box { background: var(--dark3); border: 1px solid var(--border2); padding: 24px; margin-bottom: 24px; }
  .prev-row { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid var(--border); font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 13px; }
  .prev-row:last-child { border-bottom: none; font-size: 16px; font-weight: 700; padding-top: 14px; margin-top: 6px; }
  .prev-label { color: var(--text3); }
  .prev-value { color: var(--text); }
  .prev-value.gold { color: var(--gold); font-size: 18px; }

  /* PAGAMENTO SIMULATO */
  .payment-box { background: var(--dark3); border: 1px solid var(--border2); padding: 24px; margin-bottom: 24px; }
  .payment-title { font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 11px; color: var(--text3); letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 16px; }
  .card-input-wrap { position: relative; }
  .card-icon { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); font-size: 18px; color: var(--text3); }
  .payment-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 12px; }
  .payment-note { font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 11px; color: var(--text3); margin-top: 12px; display: flex; align-items: center; gap: 6px; }

  /* SUCCESS */
  .booking-success { display: none; text-align: center; padding: 60px 40px; background: var(--dark2); border: 1px solid var(--border); }
  .booking-success.show { display: block; }
  .success-icon { font-size: 48px; margin-bottom: 20px; }
  .success-title { font-size: 28px; letter-spacing: 0.06em; color: var(--text); margin-bottom: 12px; }
  .success-sub { font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 14px; color: var(--text2); margin-bottom: 32px; line-height: 1.8; max-width: 480px; margin-left: auto; margin-right: auto; }
  .success-ref { font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 12px; color: var(--text3); letter-spacing: 0.08em; }
  .success-ref span { color: var(--gold); font-weight: 700; }

  /* ---- PERCHE ---- */
  #perche { background: var(--black); }
  .perche-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 40px; }
  .perche-item { border-top: 1px solid var(--border); padding-top: 28px; }
  .perche-num { font-size: 11px; color: var(--gold); letter-spacing: 0.14em; margin-bottom: 16px; font-family: -apple-system, BlinkMacSystemFont, sans-serif; }
  .perche-title { font-size: 18px; letter-spacing: 0.04em; color: var(--text); margin-bottom: 10px; }
  .perche-text { font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 13px; color: var(--text3); line-height: 1.8; }

  /* ---- FOOTER ---- */
  footer { background: var(--dark); border-top: 1px solid var(--border); padding: 60px 32px 40px; }
  .footer-inner { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 40px; }
  .footer-logo-main { font-size: 16px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold); margin-bottom: 4px; }
  .footer-logo-sub { font-size: 9px; color: var(--text3); letter-spacing: 0.3em; text-transform: uppercase; margin-bottom: 16px; }
  .footer-text { font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 12px; color: var(--text3); line-height: 1.8; }
  .footer-title { font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 10px; color: var(--gold); letter-spacing: 0.2em; text-transform: uppercase; margin-bottom: 16px; }
  .footer-bottom { max-width: 1100px; margin: 40px auto 0; padding-top: 24px; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
  .footer-copy { font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 11px; color: var(--text3); }

  /* ---- TOAST ---- */
  #toast { position: fixed; bottom: 32px; left: 50%; transform: translateX(-50%) translateY(20px); background: var(--dark2); color: var(--text); border: 1px solid var(--gold); padding: 14px 28px; font-family: -apple-system, BlinkMacSystemFont, sans-serif; font-size: 13px; opacity: 0; transition: all 0.25s; pointer-events: none; white-space: nowrap; z-index: 200; letter-spacing: 0.04em; }
  #toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
  #toast.err { border-color: var(--danger); color: var(--danger); }

  /* ---- LOADER ---- */
  .btn-loading { opacity: 0.7; pointer-events: none; }

  /* ---- RESPONSIVE ---- */
  @media (max-width: 768px) {
    .nav-links { display: none; }
    .numeri-grid { grid-template-columns: repeat(2, 1fr); }
    .numero-item:nth-child(2) { border-right: none; }
    .form-grid { grid-template-columns: 1fr; }
    .payment-row { grid-template-columns: 1fr; }
    .footer-inner { grid-template-columns: 1fr; }
    .footer-bottom { flex-direction: column; gap: 12px; text-align: center; }
    .booking-steps { display: none; }
    .booking-form { padding: 24px 20px; }
  }
  @media (max-width: 480px) {
    section { padding: 70px 20px; }
    .hero { padding: 100px 20px 60px; }
    .header-inner { padding: 14px 20px; }
  }
</style>
</head>
<body>

<!-- HEADER -->
<header>
  <div class="header-inner">
    <div class="logo">
      <div class="logo-main">Venice Executive Driver</div>
      <div class="logo-sub">Trasporto Privato di Lusso</div>
    </div>
    <nav class="nav-links">
      <a href="#servizi">Servizi</a>
      <a href="#perche">Chi siamo</a>
      <a href="#prenota">Prenota</a>
    </nav>
    <a href="#prenota" class="btn-prenota-nav">Prenota ora</a>
  </div>
</header>

<!-- HERO -->
<section style="padding:0">
  <div class="hero">
    <div>
      <div class="hero-eyebrow">Venezia · Servizio Privato NCC</div>
      <h1>Il trasporto privato<br>che <em>merita</em> Venezia</h1>
      <div class="hero-line"></div>
      <p class="sans">Puntualità, discrezione e comfort in ogni spostamento. Copriamo Venezia e un raggio di 150 km con veicoli di rappresentanza e autisti professionisti.</p>
      <div class="hero-cta">
        <a href="#prenota" class="btn-primary">Prenota il tuo trasferimento</a>
        <a href="#servizi" class="btn-outline">Scopri i servizi</a>
      </div>
    </div>
    <div class="hero-scroll sans">
      <div class="scroll-line"></div>
      Scorri
    </div>
  </div>
</section>

<!-- NUMERI -->
<div id="numeri">
  <div class="numeri-grid">
    <div class="numero-item">
      <div class="numero-val">150<span style="font-size:24px">km</span></div>
      <div class="numero-lbl sans">Raggio di servizio</div>
    </div>
    <div class="numero-item">
      <div class="numero-val">24<span style="font-size:24px">h</span></div>
      <div class="numero-lbl sans">Disponibilità</div>
    </div>
    <div class="numero-item">
      <div class="numero-val">10<span style="font-size:24px">+</span></div>
      <div class="numero-lbl sans">Anni di esperienza</div>
    </div>
    <div class="numero-item">
      <div class="numero-val">100<span style="font-size:24px">%</span></div>
      <div class="numero-lbl sans">Puntualità garantita</div>
    </div>
  </div>
</div>

<!-- SERVIZI -->
<section id="servizi">
  <div class="section-inner">
    <div class="section-eyebrow sans">I nostri servizi</div>
    <h2 class="section-title">Ogni spostamento,<br>un'esperienza</h2>
    <div class="section-line"></div>
    <div class="servizi-grid">
      <div class="servizio-card">
        <div class="serv-icon">✈️</div>
        <div class="serv-nome">Trasferimento Aeroporto</div>
        <div class="serv-desc sans">Accoglienza in sala arrivi, assistenza bagagli e trasporto diretto verso la tua destinazione. Copriamo tutti gli aeroporti del Nord-Est.</div>
        <div class="serv-prezzo sans">Da 120 € · fino a 150 km</div>
      </div>
      <div class="servizio-card">
        <div class="serv-icon">🏨</div>
        <div class="serv-nome">Transfer Hotel & Business</div>
        <div class="serv-desc sans">Trasferimenti puntuali per meeting, eventi aziendali e occasioni di rappresentanza. Riservatezza e professionalità garantite.</div>
        <div class="serv-prezzo sans">Da 80 € · tariffa fissa</div>
      </div>
      <div class="servizio-card">
        <div class="serv-icon">🌙</div>
        <div class="serv-nome">Servizio Serale & Eventi</div>
        <div class="serv-desc sans">Cene di gala, teatro, eventi privati. Il tuo autista ti aspetta per tutta la durata della serata senza costi aggiuntivi di attesa.</div>
        <div class="serv-prezzo sans">Da 150 € · serata completa</div>
      </div>
      <div class="servizio-card">
        <div class="serv-icon">🗺️</div>
        <div class="serv-nome">City Tour Privato</div>
        <div class="serv-desc sans">Scopri Venezia e dintorni con una guida privata a bordo di un veicolo di lusso. Itinerario personalizzato su richiesta.</div>
        <div class="serv-prezzo sans">Da 200 € · 4 ore</div>
      </div>
    </div>
  </div>
</section>

<!-- PRENOTA -->
<section id="prenota">
  <div class="section-inner">
    <div class="section-eyebrow sans">Prenotazione online</div>
    <h2 class="section-title">Prenota il tuo<br>trasferimento</h2>
    <div class="section-line"></div>

    <div class="booking-wrap">

      <!-- STEPS -->
      <div class="booking-steps sans">
        <div class="step">
          <div class="step-num active" id="snum-1">1</div>
          <div class="step-lbl active" id="slbl-1">Dettagli corsa</div>
        </div>
        <div class="step-line"></div>
        <div class="step">
          <div class="step-num" id="snum-2">2</div>
          <div class="step-lbl" id="slbl-2">I tuoi dati</div>
        </div>
        <div class="step-line"></div>
        <div class="step">
          <div class="step-num" id="snum-3">3</div>
          <div class="step-lbl" id="slbl-3">Pagamento</div>
        </div>
      </div>

      <!-- FORM -->
      <div class="booking-form" id="booking-form">

        <!-- STEP 1 — Dettagli corsa -->
        <div class="form-section active" id="step1">
          <div class="form-title">Dettagli della corsa</div>
          <div class="form-sub sans">Inserisci i dettagli del tuo spostamento</div>
          <div class="form-grid">
            <div class="form-group full">
              <label class="form-label sans">Tipo di servizio</label>
              <select class="form-select sans" id="s-servizio" onchange="aggiornaPrezzoBase()">
                <option value="">Seleziona un servizio...</option>
                <option value="aeroporto" data-prezzo="120">✈️ Trasferimento Aeroporto — da 120 €</option>
                <option value="business" data-prezzo="80">🏨 Transfer Business — da 80 €</option>
                <option value="serale" data-prezzo="150">🌙 Servizio Serale & Eventi — da 150 €</option>
                <option value="tour" data-prezzo="200">🗺️ City Tour Privato — da 200 €</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label sans">Data</label>
